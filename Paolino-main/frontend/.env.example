# =====================================================
# PAOLINO FRONTEND - ENVIRONMENT VARIABLES TEMPLATE
# =====================================================
#
# ISTRUZIONI:
# 1. Copia questo file in `.env` nella stessa directory
# 2. Sostituisci i valori con le configurazioni corrette
# 3. NON committare MAI il file `.env` (protetto da .gitignore)
#
# =====================================================

# Backend API URL
# Development: http://localhost:5031/api
# Production: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5031/api
VITE_SERVER_URL=http://localhost:5031

# Stripe Publishable Key (Safe to expose in frontend)
# Ottieni la chiave da: https://dashboard.stripe.com/apikeys
# Usa TEST key in development: pk_test_...
# Usa LIVE key in production: pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
