# =====================================================
# PAOLINO E-COMMERCE - ENVIRONMENT VARIABLES TEMPLATE
# =====================================================
#
# ISTRUZIONI:
# 1. Copia questo file in `.env` nella stessa directory
# 2. Sostituisci tutti i valori placeholder con chiavi reali
# 3. NON committare MAI il file `.env` (protetto da .gitignore)
#
# =====================================================

# Server Configuration
NODE_ENV=development
PORT=5031

# Database Configuration
# IMPORTANTE: Cambia in produzione con MongoDB Atlas o simili
MONGODB_URI=mongodb://localhost:27017/paolino_ecommerce

# JWT Authentication
# CRITICAL: Genera chiavi sicure con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_CHANGE_ME
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_CHANGE_ME

# Stripe Payment Integration
# Ottieni le chiavi da: https://dashboard.stripe.com/apikeys
# Usa TEST keys in development, LIVE keys in production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# CORS Configuration
# In development: http://localhost:5173
# In production: https://yourdomain.com
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration (Image Storage)
# Ottieni le credenziali da: https://cloudinary.com/console
# CRITICAL: Proteggere queste chiavi, NON committarle
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Credentials (Initial Setup)
# Usati dallo script npm run setup
# Email: admin@paolino.com
# Password: admin123
# CAMBIA LA PASSWORD DOPO IL PRIMO LOGIN!
